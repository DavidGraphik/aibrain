# Use "demo" only for local UI/runtime validation. Production fails closed
# unless this is explicitly set to "supabase" with all public values below.
AIBRAIN_AUTH_MODE=demo
# Versioned, non-secret installation identity, branding and filesystem layout.
# Production requires an absolute path. Development defaults to the synthetic fixture.
# AIBRAIN_INSTALLATION_CONFIG=/absolute/path/to/installation.json
# Default UI and reply language when no installation/personal preference is saved.
# Allowed: ca, es, en. Unset defaults to en; explicit saved choices take precedence.
# AIBRAIN_DEFAULT_UI_LOCALE=en
# Optional UX review gate. It is accepted only when VERCEL_ENV=preview; it can
# never enable demo auth on a Vercel production deployment.
# AIBRAIN_ENABLE_PREVIEW_DEMO=1
# Used for opaque Codex thread tokens in every auth mode. Never commit a real value.
AIBRAIN_SESSION_SECRET=replace-with-a-long-random-local-secret
# Comma-separated local user UUIDs allowed to read company-wide usage.
# AIBRAIN_USAGE_ADMIN_USER_IDS=00000000-0000-4000-8000-000000000001
# Canonical HTTPS origin used in email redirects and invitations.
# AIBRAIN_PUBLIC_URL=https://brain.example.com

# Personal email OAuth. Configure only providers enabled in the installation
# catalog; keep all values in the host secret manager, never in installation JSON.
# AIBRAIN_GOOGLE_CLIENT_ID=
# AIBRAIN_GOOGLE_CLIENT_SECRET=
# AIBRAIN_GOOGLE_OAUTH_ENCRYPTION_KEY=
# AIBRAIN_MICROSOFT_CLIENT_ID=
# AIBRAIN_MICROSOFT_CLIENT_SECRET=
# AIBRAIN_MICROSOFT_OAUTH_ENCRYPTION_KEY=
# Additional reviewed personal OAuth apps (Google Calendar/Drive, Microsoft
# Calendar/OneDrive, GitHub and Slack) use Composio. Tokens remain at the
# provider; AiBrain stores only an opaque per-user account binding.
# AIBRAIN_COMPOSIO_API_KEY=
# Optional first-connect provisioning only: toolkits read + auth configs read/write
# AIBRAIN_COMPOSIO_CATALOG_API_KEY=

# Optional support delivery. The request is persisted before notification;
# configure either one HTTPS webhook or both Telegram values.
# AIBRAIN_SUPPORT_WEBHOOK_URL=https://support.example.com/aibrain
# AIBRAIN_SUPPORT_TELEGRAM_BOT_TOKEN=
# AIBRAIN_SUPPORT_TELEGRAM_CHAT_ID=

# Production identity only. Use the new sb_publishable_ key.
# NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Demo-only manifest overlays. Use /tmp for an ephemeral Vercel preview.
# Supabase mode never falls back to this directory.
CONTROL_PLANE_DATA_DIR=/var/lib/aibrain/control-plane

CHAT_RUNTIME=codex
# Hosted deployments use a server-owned OpenAI project API key; see docs/HOSTED_CODEX.md.
# NODE_ENV=production selects this mode even when the variable is omitted.
AIBRAIN_MODEL_AUTH=server-api-key
CODEX_BIN=codex
CODEX_HOME_ROOT=/var/lib/aibrain/codex
CODEX_WORKSPACE_ROOT=/var/lib/aibrain/workspaces
# Optional: let Codex choose its default supported model.
# CODEX_MODEL=
CODEX_APPROVAL_POLICY=never
AIBRAIN_BROWSER_INTERACTIVE_APPROVALS=disabled
CODEX_SANDBOX=workspace-write
# Development-only personal Codex compatibility; see docs/PERSONAL_CODEX_ACCESS.md.
# AIBRAIN_MODEL_AUTH=personal-codex
# Private one-owner QA requires its root-owned expiring profile; see docs/PERSONAL_CODEX_ACCESS.md.
# AIBRAIN_MODEL_AUTH=personal-test
# Optional backend-only per-user access-token broker. No refresh tokens are
# accepted. Derives <root>/<installationId>/<canonical-user-UUID>.sock;
# root-owned directories/socket, no shared/owner auth configuration.
# AIBRAIN_CODEX_USER_ACCESS_SOCKET_ROOT=/run/aibrain-user-access
# AIBRAIN_CODEX_AUTH_SCOPE=per-user

# Optional offline, explicitly scoped provisioning. Bind identities in the private
# host environment before invoking the corresponding provisioning command.
# AIBRAIN_PROVISIONING_ALLOWED_EMAILS=owner@example.test,admin@example.test,one@example.test,two@example.test,three@example.test
# AIBRAIN_PROVISIONING_OWNER_EMAIL=owner@example.test
# AIBRAIN_PROVISIONING_ADMIN_EMAIL=admin@example.test
# MODTIME_REPORTING_OWNER_EMAIL=operator@example.test
# MODTIME_REPORTING_ALLOWED_EMAILS=operator@example.test,store-owner@example.test
# External reviewed repository/image ownership registry. If unset, promotion is denied.
# AIBRAIN_RELEASE_OWNERSHIP_FILE=/absolute/private/path/to/release-ownership.json

# Public source uses synthetic identity defaults. Supply reviewed private bindings
# only in the server secret store; see docs/CONFIGURATION.md.
# AIBRAIN_DEPLOYMENT_IDENTITIES={"operator":"operator@example.invalid"}
# AIBRAIN_SIBEMA_ORIGIN=https://erp.example.invalid
# AIBRAIN_ATTIO_WORKSPACE=example-workspace
# AIBRAIN_RELEASE_OWNERSHIP_FILE=/absolute/private/path/release-ownership.json
# Optional protected artwork registry and reviewed host-preflight decisions.
# AIBRAIN_DESIGN_BRAND_ASSETS_FILE=/absolute/private/path/brand-assets.json
# AIBRAIN_BRAND_ASSET_ROOT=/absolute/private/path/approved-brand-assets
# AIBRAIN_HOST_LOSS_ACCEPTANCE_ID=
# AIBRAIN_EXPECTED_PUBLIC_ORIGIN=https://brain.example.com
